// made by Niko Chevrier for PDVR.
// this is the vertical blur pass, plus desaturation, plus vignette

//#version 330

float blurWeight( float r, float dist ){
    if(r <= 0.0) return 0.0;
    return 1.0 - (abs(dist) / r);
}

void main(){
    // Normalized pixel coordinates (from 0 to 1)
    vec2 uv = vec2(TexCoord);
    
    // replace all reference of iChannel0,uv with InputTexture,TexCoord for gzdoom!!!
    vec4 thisColor = texture(InputTexture,TexCoord);
    
    
    // BLUR
    
    // radius 0.0 to 0.02 from 60% to 180% intensity
    float blurRadius = (clamp(fatigue - 0.6, 0.0, 1.2) / 1.2) * 0.02;
    vec4 blurredColor = thisColor;
    // one step is 0.001 uv
    float stepsize = 0.001;
    if(blurRadius >= stepsize){
        // for normalization we tally up the collective weights from each step
        float totalweight = 1.0;
        // vertical pass:
        // note - must normalize step size based on aspect ratio!
        // unsure if I've correctly done this below or not.
        vec2 dimensions = vec2(textureSize(InputTexture,0));
        float ratio = dimensions.x / dimensions.y;
        for(float i = stepsize;i < blurRadius;i+=stepsize){
            // to the up!
            blurredColor += vec4(texture(InputTexture,TexCoord - vec2(0.0,i / ratio)).rgb,1.0) * blurWeight(blurRadius,i);
            // to the down.
            blurredColor += vec4(texture(InputTexture,TexCoord + vec2(0.0,i / ratio)).rgb,1.0) * blurWeight(blurRadius,i);
            // add weight:
            totalweight += blurWeight(blurRadius,i) * 2.0;
        }
        // divide value down by the collective weights
        blurredColor /= vec4(vec3(totalweight),1.0);
    }
    // should be no need to clamp but just in case might as well
    blurredColor = clamp(blurredColor, vec4(0.0), vec4(1.0));
    
    
    // DESATURATION
    
    //average of RGB values
	float desatVal = (blurredColor.r + blurredColor.g + blurredColor.b) / 3.0;
    //keep the original alpha
	vec4 desatColor = vec4(desatVal,desatVal,desatVal,thisColor.a);
    //mix between original color and desaturated color, from 60% to 100% intensity
	vec4 affectedColor = mix(blurredColor,desatColor,clamp(fatigue - 0.6, 0.0, 0.4) / 0.4);
    //FragColor = affectedColor;
    
    
    // VIGNETTE
    
    uv -= vec2(0.5,0.5);
	
	//de-ellipse-ify
	uv.y /= 16.0/9.0;
	//slightly re-ellipse-ify; perfect circle still feels weird
	uv.y *= 1.3;
	
	float dist = length(uv);
	//inner edge of the vignette gradient
	float radius = mix(1.1,0.05,fatigue * 1.5 + 0.0);
	//distance from the inner edge to the outer edge (beyond which is 100% opaque)
	float softness = mix(0.25,0.45,fatigue * 4.5);
	
	float vignetteStr = smoothstep(radius, radius + softness, dist);
	
	vec4 vignetteCol = vec4(0.0, 0.0, 0.0, 1.0);
	
    //blend between desat affected color and vignette affected color
	FragColor = mix(affectedColor,vignetteCol,vignetteStr);
}